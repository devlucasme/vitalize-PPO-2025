generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int        @id @default(autoincrement())
  name              String
  email             String     @unique
  password          String
  resetToken        String?    @map("reset_token")
  resetTokenExpires DateTime?  @map("reset_token_expires")
  Diet              Diet[]
  Training          Training[]
  createAt          DateTime   @default(now()) @map("create_at")
  updateAt          DateTime   @updatedAt @map("update_at")

  @@map("users")
}

model Diet {
  id               Int    @id @default(autoincrement())
  userId           Int
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  age              Int
  sex              String
  weightKg         Float  @map("weight_kg")
  heightCm         Float  @map("height_cm")
  hipCircumference Float  @map("hip_circumference") @default(0)
  activityLevel    String @map("activity_level")
  objective        String
  trainingPlace    String @map("training_place")
  plan             String

  budGetLevel      String @default("Médio") @map("bud_get_level")
  healthConditions String @default("Nenhuma") @map("health_conditions")

  createAt DateTime @default(now()) @map("create_at")
  updateAt DateTime @updatedAt @map("update_at")

  @@map("diets")
}

model Training {
  id               Int    @id @default(autoincrement())
  userId           Int
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  age              Int
  sex              String
  weightKg         Float  @map("weight_kg")
  heightCm         Float  @map("height_cm")
  hipCircumference Float  @map("hip_circumference") @default(0)
  activityLevel    String   @map("activity_level")
  objective        String
  trainingPlace    String   @map("training_place")
  plan             String
  budGetLevel      String   @default("Médio") @map("bud_get_level")
  healthConditions String   @default("Nenhuma") @map("health_conditions")
  createAt         DateTime @default(now()) @map("create_at")
  updateAt         DateTime @updatedAt @map("update_at")

  @@map("trainings")
}
